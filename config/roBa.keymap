#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        eng {
            bindings = <&kp INTERNATIONAL_5>;
            key-positions = <37 38>;
        };

        kana {
            bindings = <&kp INTERNATIONAL_4>;
            key-positions = <38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W         &kp E         &kp R                           &kp T                                                             &kp Y        &kp U  &kp I      &kp O    &lt 4 P
&kp A            &kp S         &kp D         &kp F                           &kp G        &lt 6 ESCAPE                          &kp LS(MINUS)  &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&kp Z            &kp X         &kp C         &kp V                           &kp B        &lt 3 TAB                             &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&lt 4 LA(GRAVE)  &kp LEFT_ALT  &kp LEFT_GUI  &mt LEFT_SHIFT INTERNATIONAL_5  &lt 2 SPACE  &mt LEFT_CONTROL INTERNATIONAL_4      &kp BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;
        };

        FUNCTION {
            bindings = <
&kp LS(N7)       &kp LS(N8)    &kp LS(N9)    &trans          &kp LS(LEFT_BRACKET)                                       &kp LS(N8)             &kp LS(N9)         &trans       &kp DOLLAR   &kp LEFT_BRACKET
&kp DOLLAR       &kp PERCENT   &kp CARET     &kp SQT         &kp AT_SIGN           &kp ESCAPE            &kp SQT        &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp AT_SIGN  &kp PERCENT  &kp EQUAL
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp SEMICOLON   &kp LS(N7)            &kp TAB               &kp SEMICOLON  &kp RIGHT_BRACKET      &kp BACKSLASH      &kp LS(N7)   &kp CARET    &kp LS(EQUAL)
&kp LG(LS(S))    &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans                &kp LEFT_CONTROL      &kp BACKSPACE  &trans                                                              &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        NUM {
            bindings = <
&kp F7                &kp F8        &kp F9        &kp F10         &trans                                       &kp N7   &kp N8  &kp N9  &kp LS(SEMICOLON)  &kp INT_YEN
&kp F4                &kp F5        &kp F6        &kp F11         &trans  &kp ESCAPE            &kp LS(MINUS)  &kp N4   &kp N5  &kp N6  &kp EQUAL          &kp MINUS
&kp F1                &kp F2        &kp F3        &kp F12         &trans  &kp TAB               &trans         &kp N1   &kp N2  &kp N3  &kp LS(SQT)        &kp FSLH
&kp LG(LS(NUMBER_4))  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans  &kp LEFT_CONTROL      &kp N0         &kp DOT                                     &kp ESC
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        ARROW {
            bindings = <
&kp LA(LC(LG(NUMBER_1)))  &trans  &trans                &kp LA(LC(LG(UP_ARROW)))  &kp LA(LC(LG(M)))                                          &trans    &trans    &kp UP_ARROW  &trans     &trans
&kp LA(LC(LG(NUMBER_2)))  &trans  &kp LA(LC(LG(LEFT)))  &kp LA(LC(LG(DOWN)))      &kp LA(LC(LG(RIGHT)))  &trans                &kp LS(HOME)  &kp HOME  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_UP
&kp LA(LC(LG(NUMBER_3)))  &trans  &trans                &kp LG(LS(RIGHT_ARROW))   &kp LA(LC(LG(N)))      &trans                &kp LS(END)   &kp END   &trans    &trans        &trans     &kp PAGE_DOWN
&kp LA(LC(LG(NUMBER_4)))  &trans  &trans                &kp LEFT_SHIFT            &trans                 &kp LEFT_CONTROL      &kp DELETE    &trans                                       &kp ESCAPE
            >;
        };

        MOUSE {
            bindings = <
&kp DEL        &trans        &kp LC(X)     &kp LC(V)       &kp LC(C)                                       &trans      &trans  &trans    &mkp MB2  &trans
&kp BACKSPACE  &trans        &trans        &kp LC(Y)       &kp LC(Z)  &trans                &trans         &trans      &trans  &mkp MB1  &mkp MB1  &mkp MB2
&trans         &trans        &trans        &trans          &trans     &trans                &trans         &trans      &trans  &mkp MB3  &mkp MB4  &mkp MB5
&trans         &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &kp ENTER  &kp LEFT_CONTROL      &kp BACKSPACE  &kp DELETE                              &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
