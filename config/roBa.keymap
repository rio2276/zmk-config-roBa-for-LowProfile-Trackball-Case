#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&kp Q            &kp W         &kp E             &kp R           &kp T                                             &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A            &kp S         &kp D             &kp F           &kp G        &lt 6 ESCAPE          &kp EQUAL      &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&kp Z            &kp X         &kp C             &kp V           &kp B        &kp LEFT_CONTROL      &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&lt 4 LG(SPACE)  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &lt 2 SPACE  &lt 3 TAB             &kp BACKSPACE  &lt 1 ENTER                             &kp ESCAPE
            >;
        };

        FUNC {
            bindings = <
&kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN     &kp BACKSLASH                                           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans  &trans
&kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &kp SEMICOLON   &kp SQT            &kp ESCAPE            &kp COLON      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE  &trans  &trans
&kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp COLON       &kp DOUBLE_QUOTES  &kp LEFT_CONTROL      &kp SEMICOLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans    &trans  &trans
&kp LG(LS(S))    &kp LALT              &kp LGUI               &kp LEFT_SHIFT  &trans             &trans                &kp BSPC       &trans                                                         &kp ESC
            >;
        };

        NUM {
            bindings = <
&kp F7                &kp F8        &kp F9            &kp F10         &trans                                         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &kp AT
&kp F4                &kp F5        &kp F6            &kp F11         &trans  &kp ESCAPE            &kp EQUAL        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp TILDE     &kp MINUS
&kp F1                &kp F2        &kp F3            &kp F12         &trans  &kp LEFT_CONTROL      &kp MINUS        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp ASTERISK  &kp SLASH
&kp LG(LS(NUMBER_4))  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT_SHIFT  &trans  &trans                &kp KP_NUMBER_0  &kp PERIOD                                                       &kp CARET
            >;
        };

        ARROW {
            bindings = <
&kp LA(LC(LG(NUMBER_1)))  &trans  &trans                      &kp LC(LA(LG(UP_ARROW)))    &kp LA(LC(LG(M)))                                               &trans    &trans          &kp UP_ARROW    &trans           &trans
&kp LA(LC(LG(NUMBER_2)))  &trans  &kp LA(LC(LG(LEFT_ARROW)))  &kp LA(LC(LG(DOWN_ARROW)))  &kp LA(LC(LG(RIGHT_ARROW)))  &trans      &kp LG(LS(SEMICOLON))  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP
&kp LA(LC(LG(NUMBER_3)))  &trans  &trans                      &kp LA(LC(LG(P)))           &kp LA(LC(LG(N)))            &trans      &kp LG(MINUS)          &kp END   &trans          &trans          &trans           &kp PAGE_DOWN
&kp LA(LC(LG(NUMBER_4)))  &trans  &trans                      &trans                      &trans                       &trans      &kp DELETE             &trans                                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans        &trans            &trans          &trans                                &trans  &trans  &trans    &trans    &trans
&trans  &trans        &trans            &trans          &trans  &trans                &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2
&trans  &trans        &trans            &trans          &trans  &kp LEFT_CONTROL      &trans  &trans  &trans  &mkp MB3  &mkp MB4  &mkp MB5
&trans  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans  &trans                &trans  &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BT {
            bindings = <
&kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &kp AT_SIGN                                   &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 3
&kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &kp SEMICOLON  &kp SQT            &trans        &trans       &trans  &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 4
&kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp COLON      &kp DOUBLE_QUOTES  &kp PIPE      &bootloader  &trans  &trans  &trans  &bt BT_SEL 2  &trans
&trans           &trans                &trans                 &trans         &trans             &trans        &trans       &trans                                &bt BT_CLR
            >;
        };
    };
};
