#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        eng {
            bindings = <&kp INTERNATIONAL_5>;
            key-positions = <37 38>;
        };

        kana {
            bindings = <&kp INTERNATIONAL_4>;
            key-positions = <38 39>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W         &kp E         &kp R           &kp T                                             &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A            &kp S         &kp D         &kp F           &kp G        &lt 6 ESCAPE          &kp LS(MINUS)  &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&kp Z            &kp X         &kp C         &kp V           &kp B        &lt 3 TAB             &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&lt 4 LA(GRAVE)  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &lt 2 SPACE  &kp LEFT_CONTROL      &kp BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;
        };

        FUNCTION {
            bindings = <
&kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans          &kp BACKSLASH                                           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE          &kp DOLLAR     &kp LEFT_BRACKET
&kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &kp COLON       &kp DOUBLE_QUOTES  &kp ESCAPE            &kp COLON      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOUBLE_QUOTES  &kp PERCENT    &kp PIPE
&kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp SEMICOLON   &kp SQT            &kp TAB               &kp SEMICOLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT            &kp AMPERSAND  &kp BACKSLASH
&kp LG(LS(L))    &kp LEFT_ALT          &kp LEFT_GUI           &kp LEFT_SHIFT  &trans             &kp LEFT_CONTROL      &kp BACKSPACE  &trans                                                                         &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        NUM {
            bindings = <
&kp F7                &kp F8        &kp F9        &kp F10         &trans                                   &kp N7   &kp N8  &kp N9  &kp PLUS      &kp AT_SIGN
&kp F4                &kp F5        &kp F6        &kp F11         &trans  &kp ESCAPE            &kp EQUAL  &kp N4   &kp N5  &kp N6  &kp TILDE     &kp MINUS
&kp F1                &kp F2        &kp F3        &kp F12         &trans  &kp TAB               &trans     &kp N1   &kp N2  &kp N3  &kp ASTERISK  &kp FSLH
&kp LG(LS(NUMBER_4))  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans  &kp LEFT_CONTROL      &kp N0     &kp DOT                                &kp ESC
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        ARROW {
            bindings = <
&kp LA(LC(LG(NUMBER_1)))  &trans  &trans                &kp LA(LC(LG(UP_ARROW)))  &kp LA(LC(LG(M)))                                        &trans    &trans    &kp UP_ARROW    &trans     &trans
&kp LA(LC(LG(NUMBER_2)))  &trans  &kp LA(LC(LG(LEFT)))  &kp LA(LC(LG(DOWN)))      &kp LA(LC(LG(RIGHT)))  &trans                &trans      &kp HOME  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp PAGE_UP
&kp LA(LC(LG(NUMBER_3)))  &trans  &trans                &kp LG(LS(RIGHT_ARROW))   &kp LA(LC(LG(N)))      &trans                &trans      &kp END   &trans    &trans          &trans     &kp PAGE_DOWN
&kp LA(LC(LG(NUMBER_4)))  &trans  &trans                &kp LEFT_SHIFT            &trans                 &kp LEFT_CONTROL      &kp DELETE  &trans                                         &kp ESCAPE
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans        &trans        &trans          &trans                                &trans  &trans  &trans    &trans    &trans
&trans  &trans        &trans        &trans          &trans  &trans                &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2
&trans  &trans        &trans        &trans          &trans  &trans                &trans  &trans  &trans  &mkp MB3  &mkp MB4  &mkp MB5
&trans  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans  &kp LEFT_CONTROL      &trans  &trans                              &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
